{
	"name": "@mostlywhat/website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"release": "auto shipit"
	},
	"engines": {
		"pnpm": ">=9",
		"node": ">=18"
	},
	"packageManager": "pnpm@10.8.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/mostlywhat/horizon.git"
	},
	"devDependencies": {
		"@auto-it/all-contributors": "^11.3.0",
		"@auto-it/conventional-commits": "^11.3.0",
		"@auto-it/first-time-contributor": "^11.3.0",
		"@auto-it/git-tag": "^11.3.0",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.8.0",
		"@lucide/svelte": "^0.511.0",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-vercel": "^5.5.2",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.8",
		"@tanstack/table-core": "^8.20.5",
		"auto": "^11.3.0",
		"bits-ui": "^2.4.1",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^2.46.1",
		"formsnap": "^2.0.1",
		"globals": "^15.14.0",
		"husky": "^9.1.7",
		"layerchart": "2.0.0-next.10",
		"lint-staged": "^15.5.1",
		"mdsvex": "^0.12.3",
		"mode-watcher": "^1.0.7",
		"paneforge": "1.0.0-next.5",
		"phosphor-svelte": "^3.0.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.12",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.0.4",
		"sveltekit-superforms": "^2.24.1",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.1.8",
		"tw-animate-css": "^1.3.3",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^6.0.0",
		"vitest": "^3.0.0",
		"zod": "^3.24.3"
	},
	"dependencies": {
		"@fontsource-variable/hubot-sans": "^5.2.5",
		"@fontsource-variable/jetbrains-mono": "^5.2.5",
		"@fontsource/chakra-petch": "^5.2.6",
		"@fontsource/tourney": "^5.2.5",
		"@inlang/paraglide-sveltekit": "^0.15.5"
	},
	"husky": {
		"hooks": {
			"pre-commit": "pnpm lint-staged",
			"commit-msg": "pnpm dlx --no -- commitlint --edit ${1}"
		}
	},
	"lint-staged": {
		"**/*": [
			"eslint --fix",
			"prettier --write --ignore-unknown"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
