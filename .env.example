# =============================================================================
# DATABASE
# =============================================================================
# For local Supabase development: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For production: Use your Supabase project's connection string
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# =============================================================================
# SUPABASE
# =============================================================================
# Get these from your Supabase project settings > API
# For local development, use the values from `supabase status` after running `supabase start`
PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key - NEVER expose this to the client
# Only used for server-side admin operations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =============================================================================
# EMAIL (RESEND)
# =============================================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_your-api-key"

# =============================================================================
# APPLICATION
# =============================================================================
# Base URL for the application (used for redirects, emails, etc.)
PUBLIC_SITE_URL="http://localhost:5173"
