# =============================================================================
# DATABASE
# =============================================================================
# For local Supabase development: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For production: Use your Supabase project's connection string
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# =============================================================================
# SUPABASE
# =============================================================================
# Get these from your Supabase project settings > API
# For local development, use the values from `supabase status` after running `supabase start`
PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key - NEVER expose this to the client
# Only used for server-side admin operations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =============================================================================
# EMAIL (SMTP via Office 365 in Supabase)
# =============================================================================
# SMTP settings configured in Supabase
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="your-email@yourdomain.com"
SMTP_PASSWORD="your-password"
SMTP_FROM_EMAIL="noreply@yourdomain.com"
SMTP_FROM_NAME="MostlyWhat Systems"

# =============================================================================
# WEBHOOKS
# =============================================================================
# Email-to-ticket webhook secret
EMAIL_WEBHOOK_SECRET="your-webhook-secret-here"

# Lemon Squeezy webhook signing secret (from Lemon Squeezy dashboard)
LEMON_SQUEEZY_WEBHOOK_SECRET="your-lemon-squeezy-webhook-secret"

# =============================================================================
# APPLICATION
# =============================================================================
# Base URL for the application (used for redirects, emails, etc.)
PUBLIC_SITE_URL="http://localhost:5173"

# =============================================================================
# SENTRY
# =============================================================================
# Get your DSN and Auth Token from https://sentry.io/settings/account/api/auth-tokens/
PUBLIC_SENTRY_DSN="your-sentry-dsn"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"